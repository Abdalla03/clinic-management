# Copy to .env and load with docker compose --env-file .env
# NEVER commit the real .env

# --- Database ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=clinic
POSTGRES_PORT=5432

# --- API ---
# Production MUST be fronted by TLS termination; the API enforces HSTS and HTTPS redirect outside Development/Testing.
# This HTTP port is for local Docker Compose only.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

# Optional full connection string override. When empty the API composes it from Database__* values below.
# docker-compose.yml maps the POSTGRES_* values above onto Database__Host/Name/User/Password.
ConnectionStrings__ClinicDb=
Database__Host=localhost
Database__User=clinic
Database__Password=change-me-strong-password

# --- JWT (Phase 1 auth) ---
# Generate with:  dotnet run --project tools/KeyGen  |  openssl rand -base64 48
# Minimum 32 bytes of entropy after base64 decoding. The API refuses to start in Production if absent.
Jwt__Issuer=clinic-api
Jwt__Audience=clinic-web
Jwt__SigningKey=
Jwt__AccessTokenMinutes=15
Jwt__MfaPendingTokenMinutes=10
Jwt__RefreshTokenDays=7

# --- Field encryption master key (Phase 5 uses it for diagnosis/notes; Phase 1 for TOTP secrets) ---
# Generate with:  openssl rand -base64 32   -> 32 bytes, then HKDF-derived per-purpose subkeys.
# Never stored in the database. Rotating this without re-encrypting existing rows makes them unreadable.
Clinic__Encryption__MasterKeyBase64=

# --- CORS ---
# Exact frontend origin, no wildcards.
Cors__AllowedOrigins__0=http://localhost:3000

# --- Frontend (web) ---
# Browser-facing URL of the API served with the SPA; used both at build time
# (VITE_API_URL ARG) and at runtime (WEB_API_URL -> config.js).
WEB_API_URL=http://localhost:8080
# Host port for the nginx frontend container.
WEB_PORT=3000

# --- Rate limiting ---
RateLimiting__AuthPerMinute=5
RateLimiting__MfaPerMinute=10

# --- Demo logins (Development and Testing only) ---
# The seeder reads these from Seed__*Password; the defaults live in appsettings.Development.json
# and are published in the README. Override them here if you do not want the published values.
# A password must satisfy the Identity policy: 12+ characters, upper, lower, digit and symbol.
# Seed__DoctorPassword=
# Seed__SecretaryPassword=
# Seed__PatientPassword=

# --- Logging ---
Serilog__MinimumLevel=Information
LOG_PATH=./logs