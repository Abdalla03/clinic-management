{
  "Database": {
    "Provider": "PostgreSQL"
  },
  "Jwt": {
    "Issuer": "clinic-api",
    "Audience": "clinic-web",
    "AccessTokenMinutes": 15,
    "MfaPendingTokenMinutes": 10,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  },
  "Clinic": {
    "Encryption": {
      "MasterKeyBase64": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPerMinute": 5,
    "MfaPerMinute": 10,
    "ApiPerMinute": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "ClinicManagement": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}